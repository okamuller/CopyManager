<Window x:Class="CopyManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CopyManager.ViewModels"
        xmlns:models="clr-namespace:CopyManager.Models"
        Title="CopyManager" Height="600" Width="900"
        MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,4">
            <Button Content="+ Add Job" Style="{StaticResource ToolbarButton}"
                    Click="OnAddJobClick"/>
            <Button Content="Start All" Style="{StaticResource ToolbarButton}"
                    Command="{Binding StartAllCommand}"/>
            <Button Content="Pause All" Style="{StaticResource ToolbarButton}"
                    Command="{Binding PauseAllCommand}"/>
            <Button Content="Settings" Style="{StaticResource ToolbarButton}"
                    Click="OnSettingsClick"/>
        </StackPanel>

        <!-- Job List -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Jobs}"
                  SelectedItem="{Binding SelectedJob}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  AlternationCount="999"
                  Margin="8,0">
            <DataGrid.Columns>
                <!-- # Column (row number shown via AlternationCount) -->
                <DataGridTemplateColumn Header="#" Width="40" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow},
                                Path=(ItemsControl.AlternationIndex), StringFormat={}{0:D}}"
                                HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Job Name -->
                <DataGridTextColumn Header="Job Name" Width="*" IsReadOnly="True"
                    Binding="{Binding Name}"/>

                <!-- Status -->
                <DataGridTextColumn Header="Status" Width="80" IsReadOnly="True"
                    Binding="{Binding Status}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"
                                    Value="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Priority -->
                <DataGridComboBoxColumn Header="Priority" Width="80"
                    SelectedItemBinding="{Binding Priority, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridComboBoxColumn.ItemsSource>
                        <x:Array Type="{x:Type models:JobPriority}">
                            <models:JobPriority>High</models:JobPriority>
                            <models:JobPriority>Normal</models:JobPriority>
                            <models:JobPriority>Low</models:JobPriority>
                        </x:Array>
                    </DataGridComboBoxColumn.ItemsSource>
                </DataGridComboBoxColumn>

                <!-- Size -->
                <DataGridTextColumn Header="Size (GB)" Width="110" IsReadOnly="True"
                    Binding="{Binding SizeDisplay}"/>

                <!-- Progress -->
                <DataGridTemplateColumn Header="Progress" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <ProgressBar Value="{Binding Progress, Mode=OneWay}"
                                             Minimum="0" Maximum="100" Height="18"/>
                                <TextBlock Text="{Binding Progress, StringFormat={}{0:F0}%}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="11"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Actions -->
                <DataGridTemplateColumn Header="" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Retry" Command="{Binding RetryCommand}"
                                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Margin="2,0" Padding="4,2"/>
                                <Button Content="Pause" Command="{Binding PauseCommand}"
                                        Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Margin="2,0" Padding="4,2"/>
                                <Button Content="Cancel" Command="{Binding CancelCommand}"
                                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Margin="2,0" Padding="4,2"/>
                                <Button Content="Delete" Command="{Binding DeleteCommand}"
                                        Margin="2,0" Padding="4,2"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

            <!-- Row Details (Job Detail Panel) -->
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="1"
                            Padding="12" Margin="4" Background="#F9F9F9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Sources:" FontWeight="SemiBold" Margin="0,2"/>
                            <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding SourcePaths}" Margin="8,2">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Destination:" FontWeight="SemiBold" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DestinationPath}" Margin="8,2"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Mode:" FontWeight="SemiBold" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Mode}" Margin="8,2"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Priority:" FontWeight="SemiBold" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Priority}" Margin="8,2"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Total Size:" FontWeight="SemiBold" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SizeDisplay}" Margin="8,2"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Started:" FontWeight="SemiBold" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Grid.Column="1"
                                       Text="{Binding StartedAt, StringFormat={}{0:yyyy-MM-dd  HH:mm:ss}}"
                                       Margin="8,2"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Elapsed:" FontWeight="SemiBold" Margin="0,2"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ElapsedTime}" Margin="8,2"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Retries:" FontWeight="SemiBold" Margin="0,2"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Margin="8,2">
                                <Run Text="{Binding RetryCount, Mode=OneWay}"/>
                                <Run Text=" / "/>
                                <Run Text="{Binding MaxRetryCount, Mode=OneWay}"/>
                            </TextBlock>

                            <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="8,4">
                                <Button Content="View FastCopy Log" Command="{Binding ViewLogCommand}"
                                        Padding="8,4"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>

        <!-- Error display for selected failed job -->
        <Border Grid.Row="2" Margin="8,0"
                Visibility="{Binding SelectedJob.CanRetry, Converter={StaticResource BoolToVisibilityConverter},
                             FallbackValue=Collapsed}">
            <TextBlock Text="{Binding SelectedJob.LastErrorMessage}"
                       Foreground="Red" FontSize="12" Margin="4"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Speed: "/>
                    <Run Text="{Binding CurrentSpeed, StringFormat={}{0:F1}}"/>
                    <Run Text=" MB/s"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Running: "/><Run Text="{Binding RunningCount}"/>
                    <Run Text="  Pending: "/><Run Text="{Binding PendingCount}"/>
                    <Run Text="  Done: "/><Run Text="{Binding CompletedCount}"/>
                    <Run Text="  Failed: "/><Run Text="{Binding FailedCount}"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
